{
  "name": "complex-schedule",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "format": "oxfmt",
    "test:level-zero": "docker compose up -d --wait db && node --experimental-strip-types --test tests/level-zero.test.mjs tests/level-zero-input.test.mjs",
    "test:level-one": "node --experimental-strip-types --test tests/level-one.test.mjs",
    "test:level-one:api": "node --test tests/level-one-api.test.mjs",
    "test:level-two": "node --experimental-strip-types --test tests/level-two.test.mjs",
    "test:level-two:api": "node --test tests/level-two-api.test.mjs",
    "test:level-three": "node --experimental-strip-types --test tests/level-three.test.mjs",
    "test:level-three:api": "node --test tests/level-three-api.test.mjs",
    "test:level-four": "node --experimental-strip-types --test tests/level-four.test.mjs",
    "test:level-four:api": "node --test tests/level-four-api.test.mjs",
    "test:level-five": "node --experimental-strip-types --test tests/level-five.test.mjs",
    "test:level-five:api": "node --test tests/level-five-api.test.mjs",
    "test:selenium": "python -B -m unittest discover -s tests/selenium -v",
    "test:selenium:brave": "python -B tests/selenium/test_horarios.py --brave -v"
  },
  "dependencies": {
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.76.0",
    "typescript": "^5.7.0"
  }
}
